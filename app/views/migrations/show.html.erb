<% content_for :title do %><%= t('migrations.show.page_title', token: @migration.token) %> - <%= EuroskyConfig::SITE_NAME %><% end %>

<% if @migration.migration_out? && @migration.progress_data&.dig('captcha_required') && @migration.progress_data&.dig('captcha_site_key') && !@migration.email_verified? %>
  <% content_for :head do %>
    <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
  <% end %>
<% end %>

<%
  # pending_plc splits in two: waiting for the person's code, or code in and the
  # identity update running
  plc_waiting = @migration.pending_plc? && !(@migration.encrypted_plc_token.present? && !@migration.plc_token_expired?)
  plc_token_submitted = @migration.pending_plc? && !plc_waiting
  show_sidebar = @migration.backup_available? || (@migration.rotation_key.present? && @migration.email_verified?) || (@migration.cancellable? && @migration.email_verified?)
  status_name = plc_waiting ? t('migrations.show.status_waiting_for_you') : t("migrations.show.status_names.#{@migration.status}", default: @migration.status.humanize)
%>

<div class="eh-container">
  <div class="eh-status<%= ' eh-no-side' unless show_sidebar %>">
    <div class="eh-card">
      <div class="eh-card-head">
        <div class="eh-card-label">
          <span><%= t('migrations.show.migration_status') %></span>
          <span class="eh-muted"><%= t('migrations.show.token_label') %> <b><%= @migration.token %></b></span>
        </div>
      </div>

      <div class="eh-card-body">
        <% if flash[:notice] %>
          <div class="eh-ok eh-sm" role="status"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="eh-warn eh-sm" role="alert"><%= flash[:alert] %></div>
        <% end %>

        <% if !@migration.email_verified? %>
          <%# Awaiting email confirmation — code entry %>
          <div class="eh-stack">
            <div class="eh-stack-xs">
              <h2 class="eh-title"><%= t('migrations.show.verify_email') %></h2>
              <p class="eh-subtitle"><%= t('migrations.show.verification_sent', email: @migration.email).html_safe %></p>
            </div>

            <%= form_with url: verify_email_path(token: @migration.token), method: :post, local: true, class: 'eh-stack' do %>
              <div class="es-field">
                <%= label_tag :verification_code, t('migrations.show.verification_label'), class: 'es-label' %>
                <%= text_field_tag :verification_code, nil, required: true, placeholder: t('migrations.show.verification_placeholder'), autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, maxlength: 7, class: "es-input eh-code-input eh-code-lg" %>
              </div>
              <% if @migration.migration_out? && @migration.progress_data&.dig('captcha_required') && @migration.progress_data&.dig('captcha_site_key') %>
                <div class="h-captcha" data-sitekey="<%= @migration.progress_data['captcha_site_key'] %>"></div>
              <% end %>
              <%= submit_tag t('migrations.show.verify_button'), class: "es-btn es-btn-primary es-btn-lg es-btn-block eh-square" %>
            <% end %>

            <div class="eh-rule-top eh-stack-sm eh-sm">
              <div class="eh-label"><%= t('migrations.show.didnt_receive') %></div>
              <ul class="eh-list eh-muted">
                <li><%= t('migrations.show.check_spam') %></li>
                <li><%= t('migrations.show.check_email_correct', email: @migration.email).html_safe %></li>
                <li><%= t('migrations.show.email_delay') %></li>
              </ul>
              <%= form_with url: resend_verification_by_token_path(@migration.token), method: :post, local: true do %>
                <button type="submit" class="es-btn es-btn-sm eh-square"><%= t('migrations.show.resend_code') %></button>
              <% end %>
            </div>
          </div>

        <% else %>

          <%# Status, progress and the move itself %>
          <div class="eh-progress">
            <div class="eh-progress-head">
              <div class="eh-progress-status">
                <span class="eh-sm eh-muted"><%= t('migrations.show.status_label') %></span>
                <span id="status-value" class="eh-status-text" data-status="<%= @migration.status %>"><span id="status-text"><%= status_name %></span></span>
              </div>
              <span id="progress-label" class="eh-progress-label"><%= plc_waiting ? t('migrations.show.progress_waiting_for_you') : "#{@migration.progress_percentage}%" %></span>
            </div>
            <div id="progress-bar-container" class="eh-bar" role="progressbar" aria-label="<%= t('migrations.show.status_label') %>" aria-valuenow="<%= @migration.progress_percentage %>" aria-valuemin="0" aria-valuemax="100">
              <div id="progress-bar" class="eh-bar-fill" style="width: <%= @migration.progress_percentage %>%"></div>
            </div>
            <% retrying = @migration.job_retrying? && @migration.current_job_step %>
            <% if retrying || !(@migration.completed? || @migration.failed?) %>
              <div class="eh-progress-meta">
                <span id="retry-info" style="<%= 'display:none;' unless retrying %>"><% if retrying %><%= t('migrations.show.retry_info', attempt: @migration.current_job_attempt, max: @migration.current_job_max_attempts, step: @migration.current_job_step.gsub('Job', '').humanize) %> · <% end %></span>
                <% unless @migration.completed? || @migration.failed? %>
                  <span id="poll-status">
                    <span id="poll-updated"></span>
                    <span id="poll-error" style="display: none;"> · <%= t('migrations.show.poll_error') %></span>
                    · <a href="#" id="poll-refresh"><%= t('migrations.show.refresh_now') %></a>
                  </span>
                <% end %>
              </div>
            <% end %>
            <table class="eh-kv">
              <tr>
                <th scope="row"><%= t('migrations.show.from') %></th>
                <td>@<%= @migration.old_handle %> · <%= @migration.old_pds_host.to_s.sub(%r{\Ahttps?://}, '') %></td>
              </tr>
              <tr>
                <th scope="row"><%= t('migrations.show.to') %></th>
                <td>@<%= @migration.new_handle %> · <%= @migration.new_pds_host.to_s.sub(%r{\Ahttps?://}, '') %></td>
              </tr>
            </table>
          </div>

          <div id="queued-notice" class="eh-well" style="<%= 'display:none;' unless @migration.progress_data&.dig('queued') %>">
            <div class="eh-well-title"><%= t('migrations.show.in_queue') %></div>
            <p id="queued-reason" class="eh-sm"><%= @migration.progress_data&.dig('queued_reason') || t('migrations.show.queue_default') %></p>
            <p class="eh-sm eh-muted"><%= t('migrations.show.queue_auto_start') %></p>
          </div>

          <% if @migration.progress_data&.dig('legacy_blob_conversion_started_at') && !@migration.progress_data&.dig('legacy_blob_conversion_completed_at') %>
            <p class="eh-well eh-well-tight eh-sm">
              <span><span class="eh-strong"><%= t('migrations.show.converting_blobs') %></span> — <%= t('migrations.show.converting_blobs_detail') %></span>
            </p>
          <% elsif @migration.progress_data&.dig('legacy_blobs_converted') == true %>
            <p class="eh-ok eh-sm"><%= t('migrations.show.blobs_converted') %></p>
          <% end %>

          <%# Files the blob stage could not transfer. The migration goes on without them; %>
          <%# they are retried in the background and can be retried here at any time,     %>
          <%# also after completion. The list is only written when the blob stage ends,    %>
          <%# so this must render for every later status, not just pending_blobs.          %>
          <% missing_blobs = @migration.progress_data&.dig('failed_blobs') || [] %>
          <% if missing_blobs.any? && !@migration.pending_blobs? && !@migration.failed? %>
            <div id="missing-files-notice" class="eh-warn eh-sm">
              <div class="eh-label"><%= t('migrations.show.missing_files_title', count: missing_blobs.length) %></div>
              <p class="eh-muted"><%= @migration.completed? ? t('migrations.show.missing_files_completed') : t('migrations.show.missing_files_detail') %></p>
              <%= form_with url: retry_failed_blobs_by_token_path(@migration.token), method: :post, local: true do %>
                <button type="submit" class="es-btn es-btn-sm eh-square"><%= t('migrations.show.retry_failed_blobs') %></button>
              <% end %>
            </div>
          <% end %>

          <% if @migration.pending_blobs? %>
            <% blobs_completed = @migration.progress_data['blobs_completed'].to_i %>
            <% blobs_total = @migration.progress_data['blobs_total'].to_i %>
            <% bytes_transferred = @migration.progress_data['bytes_transferred'].to_i %>
            <% if blobs_total > 0 %>
              <div id="blob-progress-section" class="eh-stack">
                <div class="eh-metrics">
                  <div class="eh-metric">
                    <span class="eh-metric-label"><%= t('migrations.show.blobs_uploaded') %></span>
                    <span class="eh-metric-value"><span id="blobs-completed"><%= blobs_completed %></span> <small>/ <span id="blobs-total"><%= blobs_total %></span> <%= t('migrations.show.files') %></small></span>
                  </div>
                  <div class="eh-metric">
                    <span class="eh-metric-label"><%= t('migrations.show.data_transferred') %></span>
                    <span class="eh-metric-value"><span id="bytes-transferred"><%= number_to_human_size(bytes_transferred) %></span></span>
                  </div>
                  <% if @migration.progress_data['failed_blobs'].present? %>
                    <div class="eh-metric">
                      <span class="eh-metric-label"><%= t('migrations.show.failed') %></span>
                      <span class="eh-metric-value"><span id="blobs-failed"><%= @migration.progress_data['failed_blobs'].length %></span> <small><%= t('migrations.show.files') %></small></span>
                    </div>
                  <% end %>
                </div>
                <p class="eh-sm eh-muted"><%= t('migrations.show.page_auto_update') %></p>
              </div>
            <% elsif @migration.progress_data['blob_count'].to_i > 0 %>
              <p id="blob-progress-section" class="eh-well eh-well-tight eh-sm">
                <span><%= t('migrations.show.preparing_blobs', count: @migration.progress_data['blob_count']).html_safe %></span>
              </p>
            <% else %>
              <div id="blob-waiting-section" class="eh-well">
                <div class="eh-well-title"><%= t('migrations.show.upload_queue_title') %></div>
                <p class="eh-sm"><%= t('migrations.show.upload_queue_detail') %></p>
                <p class="eh-sm eh-muted"><%= t('migrations.show.page_auto_update') %></p>
              </div>
            <% end %>
          <% end %>

          <% if @migration.pending_download? || @migration.pending_backup? %>
            <div class="eh-well eh-sm">
              <p>
                <% if @migration.pending_download? %>
                  <span class="eh-strong"><%= t('migrations.show.downloading_account') %></span> — <%= t('migrations.show.downloading_detail') %>
                <% else %>
                  <span class="eh-strong"><%= t('migrations.show.creating_backup') %></span> — <%= t('migrations.show.creating_backup_detail') %>
                <% end %>
              </p>
              <% if @migration.progress_data&.dig('download_progress') %>
                <% progress = @migration.progress_data['download_progress'] %>
                <p class="eh-mono eh-muted">
                  <%= t('migrations.show.downloaded_count', downloaded: progress['downloaded'], total: progress['total']) %>
                  <% if progress['bytes'] %>(<%= number_to_human_size(progress['bytes']) %>)<% end %>
                </p>
              <% end %>
            </div>
          <% end %>

          <% if @migration.backup_bundle_path.present? && @migration.backup_expired? %>
            <p class="eh-warn eh-sm"><span><span class="eh-strong"><%= t('migrations.show.backup_expired') %></span> — <%= t('migrations.show.backup_expired_detail') %></span></p>
          <% end %>

          <%# ── State-specific main content ── %>

          <% if plc_token_submitted %>
            <div class="eh-stack-sm eh-rule-top">
              <h2 class="eh-title"><%= t('migrations.show.updating_identity') %></h2>
              <p class="eh-sm eh-muted"><%= t('migrations.show.plc_accepted', pds: @migration.new_pds_host).html_safe %></p>
              <p class="eh-sm eh-muted"><%= t('migrations.show.page_auto_update') %></p>
            </div>

          <% elsif plc_waiting %>
            <div class="eh-warn">
              <h2 class="eh-title"><%= t('migrations.show.action_required_title') %></h2>
              <p class="eh-sm eh-muted"><%= t('migrations.show.action_required_detail').html_safe %></p>
              <ul class="eh-sm eh-list">
                <li><%= t('migrations.show.action_required_check_email') %></li>
                <li><%= t('migrations.show.action_required_look_for', pds: @migration.old_pds_host).html_safe %></li>
                <li><%= t('migrations.show.action_required_not_same_email') %></li>
              </ul>
            </div>

            <%= form_with url: submit_plc_token_by_token_path(@migration.token), method: :post, local: true, class: 'eh-stack' do %>
              <div class="es-field">
                <%= label_tag :plc_token, t('migrations.show.confirmation_label'), class: 'es-label' %>
                <%= text_field_tag :plc_token, nil, required: true, placeholder: t('migrations.show.confirmation_placeholder'), autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, class: "es-input eh-code-input eh-code-md", aria: { describedby: 'plc-token-hint' } %>
                <div class="es-hint" id="plc-token-hint"><%= t('migrations.show.confirmation_hint', pds: @migration.old_pds_host).html_safe %></div>
              </div>
              <%= submit_tag t('migrations.show.complete_migration'), class: "es-btn es-btn-primary es-btn-lg es-btn-block eh-square", onclick: "return confirm('#{j t('migrations.show.complete_confirm')}');" %>
            <% end %>

            <div class="eh-rule-top eh-stack-sm">
              <details class="eh-details" open>
                <summary><%= t('migrations.show.didnt_receive_plc') %></summary>
                <div class="eh-details-body">
                  <ul class="eh-list eh-muted">
                    <li><%= t('migrations.show.plc_check_spam') %></li>
                    <li><%= t('migrations.show.plc_from_old_pds', pds: @migration.old_pds_host) %></li>
                    <li><%= t('migrations.show.plc_expires') %></li>
                  </ul>
                  <% if @migration.has_old_pds_tokens? %>
                    <form action="<%= request_new_plc_token_by_token_path(@migration.token) %>" method="post">
                      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                      <button type="submit" class="es-btn es-btn-sm eh-square"><%= t('migrations.show.request_new_code') %></button>
                    </form>
                  <% else %>
                    <p class="eh-muted"><%= t('migrations.show.plc_new_code_help') %></p>
                    <form action="<%= reauthenticate_by_token_path(@migration.token) %>" method="post" class="eh-inline-form">
                      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                      <input type="password" name="password" required autocomplete="current-password"
                             placeholder="<%= t('migrations.show.plc_password_placeholder', handle: @migration.old_handle) %>"
                             aria-label="<%= t('migrations.show.plc_password_placeholder', handle: @migration.old_handle) %>"
                             class="es-input">
                      <button type="submit" class="es-btn eh-square"><%= t('migrations.show.request_new_code') %></button>
                    </form>
                  <% end %>
                </div>
              </details>

              <details class="eh-details-quiet">
                <summary><%= t('migrations.show.technical_details') %></summary>
                <div class="eh-details-body eh-muted">
                  <p><%= t('migrations.show.plc_explanation').html_safe %></p>
                  <p><%= t('migrations.show.plc_irreversible', new_pds: @migration.new_pds_host, old_pds: @migration.old_pds_host).html_safe %></p>
                  <p><%= t('migrations.show.plc_expiry_note') %></p>
                </div>
              </details>
            </div>

          <% elsif @migration.completed? %>
            <div class="eh-stack">
              <div class="eh-stack-xs">
                <h2 class="eh-title"><%= t('migrations.show.completed_title') %></h2>
                <p class="eh-sm eh-muted">
                  <% if @migration.returning_to_existing_pds? %>
                    <%= t('migrations.show.completed_migrated_back', pds: h(@migration.new_pds_host), handle: h(@migration.new_handle)).html_safe %>
                  <% else %>
                    <%= t('migrations.show.completed_migrated_to', pds: h(@migration.new_pds_host), handle: h(@migration.new_handle)).html_safe %>
                  <% end %>
                </p>
              </div>
              <p class="eh-sm eh-muted"><%= t('migrations.show.email_sent_html', email: @migration.email).html_safe %></p>

              <% if @migration.rotation_key.present? %>
                <div class="eh-warn eh-sm">
                  <div class="eh-label"><%= t('migrations.show.save_rotation_key') %></div>
                  <p class="eh-muted"><span class="eh-strong"><%= t('migrations.show.page_auto_delete') %></span> <%= t('migrations.show.rotation_key_needed') %></p>
                  <code class="eh-code-block"><%= @migration.rotation_key %></code>
                  <div>
                    <button type="button" class="es-btn es-btn-sm eh-square" data-copy="<%= @migration.rotation_key %>" data-copied="<%= t('migrations.show.copied') %>"><%= t('migrations.show.copy_rotation_key') %></button>
                  </div>
                  <p class="eh-muted"><%= t('migrations.show.key_emailed', email: @migration.email).html_safe %></p>
                </div>
              <% end %>

              <div class="eh-rule-top eh-stack-sm eh-sm">
                <div class="eh-label"><%= t('migrations.show.privacy_notice') %></div>
                <p class="eh-muted"><%= t('migrations.show.privacy_detail').html_safe %></p>
                <p class="eh-muted"><%= t('migrations.show.privacy_delete_now') %></p>
              </div>

              <form action="<%= confirm_delete_by_token_path(@migration.token) %>" method="post"
                    onsubmit="return confirm('<%= j t('migrations.show.delete_confirm') %>');">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <button type="submit" class="es-btn es-btn-block eh-square"><%= t('migrations.show.delete_button') %></button>
              </form>

              <p class="eh-sm eh-muted">
                <%= @migration.returning_to_existing_pds? ? t('migrations.show.welcome_back') : t('migrations.show.welcome_new') %>
              </p>
            </div>

          <% elsif @migration.failed? %>
            <%= render 'migrations/error_details', migration: @migration %>
          <% end %>

          <%# Recovery key with the how-to-revert notes, while the move is still running %>
          <% if @migration.rotation_key.present? && !@migration.completed? && !@migration.pending_download? && !@migration.pending_backup? %>
            <details class="eh-details eh-rule-top">
              <summary><%= t('migrations.show.recovery_key_title') %></summary>
              <div class="eh-details-body">
                <p class="eh-muted"><span class="eh-strong"><%= t('migrations.show.recovery_key_important') %></span> <%= t('migrations.show.recovery_key_help') %></p>
                <code class="eh-code-block"><%= @migration.rotation_key %></code>
                <div>
                  <button type="button" class="es-btn es-btn-sm eh-square" data-copy="<%= @migration.rotation_key %>" data-copied="<%= t('migrations.show.copied') %>"><%= t('migrations.show.copy_clipboard') %></button>
                </div>
                <details class="eh-details-quiet">
                  <summary><%= t('migrations.show.revert_title') %></summary>
                  <div class="eh-details-body eh-muted">
                    <p><%= t('migrations.show.revert_help') %></p>
                    <ol class="eh-list">
                      <li><%= t('migrations.show.revert_step1').html_safe %></li>
                      <li><%= t('migrations.show.revert_step2').html_safe %></li>
                      <li><%= t('migrations.show.revert_step3') %></li>
                      <li><%= t('migrations.show.revert_step4').html_safe %></li>
                      <li><%= t('migrations.show.revert_step5').html_safe %></li>
                      <li><%= t('migrations.show.revert_step6').html_safe %></li>
                    </ol>
                    <p class="eh-warn"><span><span class="eh-strong"><%= t('migrations.show.revert_note') %></span> <%= t('migrations.show.revert_warning') %></span></p>
                  </div>
                </details>
              </div>
            </details>
          <% end %>

        <% end %><%# end of email_verified? if/else %>
      </div>
    </div>

    <% if show_sidebar %>
      <aside class="eh-side">
        <% if @migration.backup_available? %>
          <div class="eh-side-box">
            <div class="eh-side-head">
              <span><%= t('migrations.show.backup_label') %></span>
              <span class="es-tag es-tag-accent"><%= t('migrations.show.backup_ready_tag') %></span>
            </div>
            <p class="eh-muted"><%= @migration.completed? ? t('migrations.show.backup_download_completed') : t('migrations.show.backup_download_ready') %></p>
            <div class="eh-side-meta">
              <span class="eh-muted"><%= t('migrations.show.size') %></span><span><%= number_to_human_size(@migration.backup_size) %></span>
              <span class="eh-muted"><%= t('migrations.show.expires') %></span><span><%= @migration.backup_expires_at.utc.strftime('%Y-%m-%d %H:%M UTC') %></span>
            </div>
            <a href="<%= migration_download_backup_path(@migration, token: @migration.token) %>" class="es-btn es-btn-block eh-square"><%= t('migrations.show.download_button') %></a>
          </div>
        <% end %>

        <% if @migration.rotation_key.present? %>
          <div class="eh-side-box">
            <div class="eh-side-head"><span><%= t('migrations.show.recovery_key') %></span></div>
            <p class="eh-muted"><%= t('migrations.show.recovery_key_sidebar') %></p>
            <code class="eh-code-block"><%= @migration.rotation_key %></code>
            <button type="button" class="es-btn es-btn-sm es-btn-block eh-square" data-copy="<%= @migration.rotation_key %>" data-copied="<%= t('migrations.show.copied') %>"><%= t('migrations.show.copy_key') %></button>
          </div>
        <% end %>

        <% if @migration.cancellable? && @migration.email_verified? %>
          <details class="eh-side-details eh-details-quiet">
            <summary><%= t('migrations.show.cancel_migration') %></summary>
            <div class="eh-details-body eh-muted">
              <p><%= t('migrations.show.cancel_help') %></p>
              <p><%= t('migrations.show.cancel_patience') %></p>
              <form action="<%= request_cancellation_by_token_path(@migration.token) %>" method="post"
                    onsubmit="return confirm('<%= j t('migrations.show.cancel_confirm') %>');">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <button type="submit" class="es-btn es-btn-ghost es-btn-sm eh-square"><%= t('migrations.show.cancel_button') %></button>
              </form>
            </div>
          </details>
        <% end %>
      </aside>
    <% end %>
  </div>
</div>

<% unless @migration.completed? || @migration.failed? %>
  <% content_for :scripts do %>
  <script>
    (function() {
      var pollUrl = '<%= migration_by_token_path(@migration.token, format: :json) %>';
      var currentStatus = '<%= @migration.status %>';
      var emailVerified = <%= @migration.email_verified? %>;
      var statusNames = <%= raw t('migrations.show.status_names').to_json %>;
      var statusWaitingText = '<%= j t('migrations.show.status_waiting_for_you') %>';
      var barWaitingText = '<%= j t('migrations.show.progress_waiting_for_you') %>';
      var lastUpdatedText = '<%= j t('migrations.show.last_updated', time: '{time}') %>';
      var retryText = '<%= j t('migrations.show.retry_info', attempt: '{attempt}', max: '{max}', step: '{step}') %>';

      // "Last updated" line + error marker, so a stalled poll is visible instead of silent
      function markPolled(ok) {
        var updated = document.getElementById('poll-updated');
        var error = document.getElementById('poll-error');
        if (ok && updated) {
          updated.textContent = lastUpdatedText.replace('{time}', new Date().toLocaleTimeString());
        }
        if (error) error.style.display = ok ? 'none' : '';
      }

      var refreshLink = document.getElementById('poll-refresh');
      if (refreshLink) {
        refreshLink.addEventListener('click', function(e) {
          e.preventDefault();
          window.location.reload();
        });
      }

      function poll() {
        fetch(pollUrl, { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
          .then(function(r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .then(function(data) {
            markPolled(true);

            // Major state transitions that change the page layout — full reload
            if (!emailVerified && data.email_verified) {
              window.location.reload();
              return;
            }
            if (data.completed || data.failed) {
              window.location.reload();
              return;
            }
            // Every status has its own layout (the PLC token form only exists in
            // the pending_plc render, the blob metrics only in pending_blobs, ...),
            // so any status change needs a full reload. Updating in place across
            // statuses left the header saying "Waiting for your input" above a
            // body that still described the blob transfer.
            if (data.status !== currentStatus) {
              window.location.reload();
              return;
            }

            // In-place updates for progress
            var bar = document.getElementById('progress-bar');
            var barContainer = document.getElementById('progress-bar-container');
            var label = document.getElementById('progress-label');
            var isPendingPlc = data.status === 'pending_plc';
            if (bar && barContainer) {
              bar.style.width = data.progress_percentage + '%';
              barContainer.setAttribute('aria-valuenow', data.progress_percentage);
            }
            if (label) {
              label.textContent = isPendingPlc ? barWaitingText : data.progress_percentage + '%';
            }

            var statusText = document.getElementById('status-text');
            if (statusText && !isPendingPlc) {
              statusText.textContent = statusNames[data.status] || data.status_humanized;
            } else if (statusText) {
              statusText.textContent = statusWaitingText;
            }

            var retryInfo = document.getElementById('retry-info');
            if (retryInfo) {
              if (data.job_retrying && data.current_job_step) {
                var stepName = data.current_job_step.replace('Job', '').replace(/([A-Z])/g, ' $1').trim();
                retryInfo.textContent = retryText.replace('{attempt}', data.current_job_attempt).replace('{max}', data.current_job_max_attempts).replace('{step}', stepName) + ' · ';
                retryInfo.style.display = '';
              } else {
                retryInfo.style.display = 'none';
              }
            }

            var queuedNotice = document.getElementById('queued-notice');
            if (queuedNotice) {
              if (data.queued) {
                queuedNotice.style.display = '';
                var queuedReason = document.getElementById('queued-reason');
                if (queuedReason && data.queued_reason) {
                  queuedReason.textContent = data.queued_reason;
                }
              } else {
                queuedNotice.style.display = 'none';
              }
            }

            // Update blob progress metrics
            var blobsCompleted = document.getElementById('blobs-completed');
            if (blobsCompleted && data.blobs_completed !== undefined) {
              blobsCompleted.textContent = data.blobs_completed;
            }
            var blobsTotal = document.getElementById('blobs-total');
            if (blobsTotal && data.blobs_total !== undefined) {
              blobsTotal.textContent = data.blobs_total;
            }
            var bytesTransferred = document.getElementById('bytes-transferred');
            if (bytesTransferred && data.bytes_transferred_formatted) {
              bytesTransferred.textContent = data.bytes_transferred_formatted;
            }
          })
          .catch(function() {
            // Keep polling, but show that the page is not up to date
            markPolled(false);
          });
      }

      markPolled(true);
      setInterval(poll, 10000);
    })();
  </script>
  <% end %>
<% end %>
