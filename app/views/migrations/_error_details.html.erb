<% if @migration.last_error.present? %>
  <% error_context = MigrationErrorHelper.explain_error(@migration) %>

  <% if error_context %>
    <div class="error-details-section eh-stack">
      <%# What went wrong, and where things stand %>
      <div class="error-header eh-warn">
        <h2 class="eh-title"><%= error_context[:title] %></h2>
        <div class="eh-stack-xs eh-sm">
          <div class="eh-label"><%= t('migrations.error_details.current_status') %></div>
          <p class="eh-muted"><%= error_context[:current_status] %></p>
        </div>

        <%# Retry information (only for errors with automatic retries) %>
        <% if error_context[:retry_info] && error_context[:retry_info][:remaining] > 0 %>
          <div class="eh-side-meta">
            <span class="eh-muted"><%= t('migrations.error_details.retry_attempt') %></span>
            <span><%= error_context[:retry_info][:attempt] %> / <%= error_context[:retry_info][:max_attempts] %></span>
            <span class="eh-muted"><%= t('migrations.error_details.remaining_attempts') %></span>
            <span><%= error_context[:retry_info][:remaining] %></span>
            <span class="eh-muted"><%= t('migrations.error_details.next_retry') %></span>
            <span id="countdown-timer"><%= t('migrations.error_details.calculating') %></span>
          </div>
        <% end %>
      </div>

      <%# Re-authentication form - shown when credentials have expired but migration data is intact %>
      <% if error_context[:show_reauth_form] %>
        <div class="eh-well">
          <div class="eh-stack-xs">
            <div class="eh-well-title"><%= t('migrations.error_details.reauth_safe') %></div>
            <p class="eh-sm eh-muted"><%= t('migrations.error_details.reauth_help', handle: @migration.old_handle).html_safe %></p>
          </div>
          <form action="<%= reauthenticate_by_token_path(@migration.token) %>" method="post" class="eh-stack-sm">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <div class="es-field">
              <label for="reauth_password" class="es-label"><%= t('migrations.error_details.password_for', handle: @migration.old_handle) %></label>
              <input type="password" name="password" id="reauth_password" required
                     autocomplete="current-password"
                     placeholder="<%= t('migrations.error_details.enter_password_placeholder') %>"
                     class="es-input">
            </div>
            <div><button type="submit" class="es-btn es-btn-primary eh-square"><%= t('migrations.error_details.reauth_button') %></button></div>
          </form>
        </div>
      <% end %>

      <%# New-account password form - the generated password for the NEW account was rejected (migration_out) %>
      <% if error_context[:show_new_pds_reauth_form] %>
        <div class="eh-well">
          <div class="eh-stack-xs">
            <div class="eh-well-title"><%= t('migrations.error_details.new_pds_reauth_safe') %></div>
            <p class="eh-sm eh-muted"><%= t('migrations.error_details.new_pds_reauth_help', pds: @migration.new_pds_host).html_safe %></p>
          </div>
          <form action="<%= reauthenticate_new_pds_by_token_path(@migration.token) %>" method="post" class="eh-stack-sm">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <div class="es-field">
              <label for="new_pds_password" class="es-label"><%= t('migrations.error_details.new_pds_password_for', pds: @migration.new_pds_host) %></label>
              <input type="password" name="password" id="new_pds_password" required
                     autocomplete="current-password"
                     placeholder="<%= t('migrations.error_details.enter_password_placeholder') %>"
                     class="es-input">
            </div>
            <div><button type="submit" class="es-btn es-btn-primary eh-square"><%= t('migrations.error_details.new_pds_reauth_button') %></button></div>
          </form>
        </div>
      <% end %>

      <%# PLC token action - shown when a new PLC token is needed %>
      <% if error_context[:show_request_new_plc_token] %>
        <div class="eh-well">
          <div class="eh-well-title"><%= t('migrations.error_details.plc_safe') %></div>

          <% if @migration.has_old_pds_tokens? %>
            <%# Old PDS session is still valid — can request token automatically %>
            <p class="eh-sm eh-muted"><%= t('migrations.error_details.plc_request_help', pds: @migration.old_pds_host).html_safe %></p>
            <form action="<%= request_new_plc_token_by_token_path(@migration.token) %>" method="post">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <button type="submit"
                      onclick="return confirm('<%= j t('migrations.error_details.request_plc_confirm') %>');"
                      class="es-btn es-btn-primary eh-square">
                <%= t('migrations.error_details.request_plc_button') %>
              </button>
            </form>
          <% else %>
            <%# Old PDS session expired — need password to re-authenticate %>
            <p class="eh-sm eh-muted"><%= t('migrations.error_details.plc_session_expired', pds: @migration.old_pds_host, handle: @migration.old_handle).html_safe %></p>
            <form action="<%= reauthenticate_by_token_path(@migration.token) %>" method="post" class="eh-stack-sm">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <div class="es-field">
                <label for="reauth_plc_password" class="es-label"><%= t('migrations.error_details.password_for', handle: @migration.old_handle) %></label>
                <input type="password" name="password" id="reauth_plc_password" required
                       autocomplete="current-password"
                       placeholder="<%= t('migrations.error_details.enter_password_placeholder') %>"
                       class="es-input">
              </div>
              <div><button type="submit" class="es-btn es-btn-primary eh-square"><%= t('migrations.error_details.reauth_plc_button') %></button></div>
            </form>
          <% end %>
        </div>
      <% end %>

      <%# What happened and what to do %>
      <details class="error-expandable eh-details eh-rule-top">
        <summary><%= t('migrations.error_details.what_happened_title') %></summary>

        <div class="eh-details-body">
          <div class="eh-stack-xs">
            <div class="eh-label"><%= t('migrations.error_details.what_happened') %></div>
            <p class="eh-muted"><%= error_context[:what_happened] %></p>
          </div>

          <div class="eh-stack-xs">
            <div class="eh-label"><%= t('migrations.error_details.what_to_do') %></div>
            <ul class="eh-list eh-muted">
              <% error_context[:what_to_do].each do |action| %>
                <li><%= action %></li>
              <% end %>
            </ul>
          </div>

          <div class="eh-actions">
            <% if error_context[:show_request_new_plc_token] %>
              <%= button_to t('migrations.error_details.request_plc_action'), request_new_plc_token_by_token_path(@migration.token),
                  method: :post,
                  data: { confirm: t('migrations.error_details.request_plc_confirm') },
                  class: "es-btn es-btn-primary eh-square" %>
            <% end %>

            <% if error_context[:show_retry_button] %>
              <%= button_to t('migrations.error_details.retry_migration'), retry_migration_by_token_path(@migration.token),
                  method: :post,
                  data: { confirm: t('migrations.error_details.retry_confirm') },
                  class: "es-btn es-btn-primary eh-square" %>
            <% end %>

            <% if error_context[:show_new_migration_button] %>
              <%= link_to t('migrations.error_details.start_new'), new_migration_path, class: "es-btn eh-square" %>
            <% end %>

            <% if error_context[:check_url] %>
              <%= link_to t('migrations.error_details.check_pds'), error_context[:check_url],
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "es-btn eh-square" %>
            <% end %>

            <% if error_context[:show_download_manifest] && @migration.progress_data&.dig('failed_blobs').present? %>
              <%= link_to t('migrations.error_details.download_report'), export_recovery_data_migration_by_token_path(@migration.token, format: :txt),
                  class: "es-btn eh-square" %>
            <% end %>
          </div>

          <% if error_context[:show_cleanup_instructions] %>
            <div class="eh-warn">
              <div class="eh-label"><%= t('migrations.error_details.cleanup_title') %></div>
              <p class="eh-muted"><%= t('migrations.error_details.cleanup_help') %></p>
              <code class="eh-code-block">cd scripts && ./cleanup_orphaned_account_db.sh <%= error_context[:did] %></code>
              <p class="eh-muted"><%= t('migrations.error_details.cleanup_contact') %></p>
            </div>
          <% end %>

          <% if error_context[:show_rotation_key] && @migration.rotation_key.present? %>
            <div class="eh-warn">
              <div class="eh-label"><%= t('migrations.error_details.rotation_key_save') %></div>
              <code class="eh-code-block"><%= @migration.rotation_key %></code>
              <div>
                <button type="button" class="es-btn es-btn-sm eh-square" data-copy="<%= @migration.rotation_key %>" data-copied="<%= t('migrations.show.copied') %>"><%= t('migrations.error_details.copy_rotation_key') %></button>
              </div>
            </div>
          <% end %>

          <% if error_context[:show_contact_support] %>
            <div class="eh-warn">
              <div class="eh-label"><%= t('migrations.error_details.contact_support') %></div>
              <div class="eh-side-meta">
                <span class="eh-muted"><%= t('migrations.error_details.support_email') %></span><span><%= error_context[:support_email] %></span>
                <span class="eh-muted"><%= t('migrations.error_details.migration_token') %></span><span><%= error_context[:migration_token] %></span>
              </div>
              <p class="eh-muted"><%= t('migrations.error_details.include_token') %></p>
            </div>
          <% end %>
        </div>
      </details>

      <%# Technical details (collapsed by default) %>
      <details class="technical-details eh-details-quiet">
        <summary><%= t('migrations.error_details.technical_title') %></summary>
        <div class="eh-details-body">
          <div class="eh-stack-xs">
            <div class="eh-label"><%= t('migrations.error_details.error_message') %></div>
            <pre class="eh-pre"><%= error_context[:technical_details] %></pre>
          </div>
          <div class="eh-side-meta">
            <% if error_context[:job_step] %>
              <span class="eh-muted"><%= t('migrations.error_details.job_step') %></span><span><%= error_context[:job_step] %></span>
            <% end %>
            <span class="eh-muted"><%= t('migrations.error_details.migration_status') %></span><span><%= @migration.status %></span>
            <span class="eh-muted"><%= t('migrations.error_details.migration_token') %></span><span><%= @migration.token %></span>
            <span class="eh-muted"><%= t('migrations.error_details.did_label') %></span><span><%= @migration.did %></span>
          </div>
        </div>
      </details>
    </div>

    <%# Auto-refresh countdown script (only when retry info is present) %>
    <% if error_context[:retry_info] %>
    <script>
      (function() {
        // Estimated retry countdown (approximation based on exponential backoff)
        const attempt = <%= error_context[:retry_info][:attempt] || 0 %>;
        const maxAttempts = <%= error_context[:retry_info][:max_attempts] || 3 %>;

        if (attempt > 0 && attempt < maxAttempts) {
          // Exponential backoff estimate: 2^attempt seconds
          let remainingSeconds = Math.pow(2, attempt);

          const countdownEl = document.getElementById('countdown-timer');
          if (countdownEl) {
            const updateCountdown = () => {
              if (remainingSeconds > 0) {
                const minutes = Math.floor(remainingSeconds / 60);
                const seconds = remainingSeconds % 60;

                if (minutes > 0) {
                  countdownEl.textContent = `${minutes}m ${seconds}s`;
                } else {
                  countdownEl.textContent = `${seconds}s`;
                }

                remainingSeconds--;
                setTimeout(updateCountdown, 1000);
              } else {
                countdownEl.textContent = '<%= j t('migrations.error_details.retrying_now') %>';
              }
            };

            updateCountdown();
          }
        }
      })();
    </script>
    <% end %>
  <% end %>
<% end %>
