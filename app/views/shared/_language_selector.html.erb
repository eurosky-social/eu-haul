<details class="eh-lang" id="eh-lang">
  <summary aria-label="<%= t('language_selector') %>">
    <span lang="<%= I18n.locale %>"><%= I18n.locale.to_s.upcase %></span>
    <span class="eh-lang-caret" aria-hidden="true">⌄</span>
  </summary>
  <ul class="eh-lang-menu">
    <% I18n.available_locales.sort.each do |loc| %>
      <li>
        <a href="<%= url_for(request.query_parameters.merge(locale: loc)) %>"
           lang="<%= loc %>"
           <%= 'aria-current="true"'.html_safe if I18n.locale == loc %>
           onclick="document.cookie='locale=<%= loc %>;path=/;max-age=31536000';">
          <%= t("language_names.#{loc}") %>
        </a>
      </li>
    <% end %>
  </ul>
</details>
