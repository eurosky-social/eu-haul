<%= email_label t('mailers.email_verification.migration_token', token: @migration.token) %>
<%= email_title t('mailers.email_verification.heading') %>

<%= email_text 'Hello,' %>
<%= email_text t('mailers.email_verification.initiated', handle: h(@migration.old_handle), pds: h(@migration.new_pds_host)).html_safe %>
<%= email_text t('mailers.email_verification.enter_code') %>

<%= email_code_block @migration.email_verification_token, size: :large, caption: 'Your verification code' %>

<%= email_button t('mailers.email_verification.go_to_page').chomp(':'), @status_url %>

<%= email_well do %>
  <%= email_heading t('mailers.email_verification.what_next') %>
  <%= email_list [
    t('mailers.email_verification.next_step1'),
    t('mailers.email_verification.next_step2'),
    t('mailers.email_verification.next_step3'),
    t('mailers.email_verification.next_step4')
  ] %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.email_verification.important') %>
  <%= email_list [
    tag.strong(t('mailers.email_verification.reminder1')),
    t('mailers.email_verification.reminder2'),
    t('mailers.email_verification.reminder3'),
    t('mailers.email_verification.reminder4')
  ] %>
<% end %>

<% email_footer do %>
  <%= email_text t('mailers.email_verification.migration_token', token: @migration.token), small: true %>
  <%= email_text t('mailers.email_verification.not_you'), small: true %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
