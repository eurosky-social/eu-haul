<%# Deliberately not translated: the subject line of the email the old PDS
    sends (in English), the code format example and the pdsmoover.com address. %>
<%= email_title t('mailers.rotation_key_notice.heading') %>

<%= email_text t('mailers.rotation_key_notice.intro') %>
<%= email_text tag.strong(t('mailers.rotation_key_notice.no_password_reset', pds: @migration.new_pds_host)) %>

<%# PLC confirmation: the action this mail asks for %>
<%= email_warning do %>
  <%= email_heading t('mailers.rotation_key_notice.check_email') %>
  <%= email_text t('mailers.rotation_key_notice.plc_email_intro', pds: @migration.old_pds_host) %>
  <%= email_well do %>
    <%= email_text tag.strong('"PLC Update Operation Requested"') %>
  <% end %>
  <%= email_text email_t('mailers.rotation_key_notice.plc_code_info', example: email_code('XXXXX-XXXXX')) %>
  <%= email_text t('mailers.rotation_key_notice.plc_enter_code') %>
  <%= email_button t('mailers.rotation_key_notice.next_step_button'), @migration_url %>
  <%= email_text t('mailers.rotation_key_notice.plc_expiry') %>
<% end %>

<%= email_divider %>

<%# Recovery key %>
<%= email_heading t('mailers.rotation_key_notice.key_heading') %>
<%= email_text t('mailers.rotation_key_notice.key_help') %>

<%= email_warning do %>
  <%= email_heading t('mailers.rotation_key_notice.save_key_heading') %>
  <% if @rotation_key_private.present? %>
    <%= email_text tag.strong(t('mailers.rotation_key_notice.recovery_key_label')) %>
    <%= email_code_block @rotation_key_private %>
    <%= email_text t('mailers.rotation_key_notice.key_warning') %>
  <% end %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.rotation_key_notice.key_use_heading') %>
  <%= email_text email_t('mailers.rotation_key_notice.key_use', link: tag.strong(email_link('pdsmoover.com/restore', 'https://pdsmoover.com/restore'))) %>
<% end %>

<% email_footer do %>
  <%= email_text email_t('mailers.common.migration_token', token: email_code(@migration.token)), small: true %>
  <%= email_text t('mailers.migration_completed.email_footer', email: @migration.email), small: true %>
<% end %>
