<%= email_title t('mailers.plc_token_reminder.heading') %>

<%= email_text t('mailers.plc_token_reminder.intro', handle: @migration.old_handle) %>

<%= email_warning do %>
  <%= email_heading t('mailers.plc_token_reminder.action_title') %>
  <%= email_text t('mailers.plc_token_reminder.action_help', pds: @migration.old_pds_host) %>
  <%= email_button t('mailers.plc_token_reminder.go_to_page'), @migration_url %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.plc_token_reminder.help_title') %>
  <%= email_list [
    t('mailers.plc_token_reminder.help_check_spam'),
    t('mailers.plc_token_reminder.help_from_old_pds', pds: @migration.old_pds_host),
    t('mailers.plc_token_reminder.help_code_format'),
    t('mailers.plc_token_reminder.help_request_new')
  ] %>
<% end %>

<% email_footer do %>
  <%= email_text small: true do %>Migration Token: <%= email_code @migration.token %><% end %>
  <%= email_text t('mailers.migration_completed.email_footer', email: @migration.email), small: true %>
<% end %>
