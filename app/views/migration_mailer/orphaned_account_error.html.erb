<% support_mail_url = "mailto:#{@target_pds_support_email}?subject=Orphaned%20Account%20Removal%20Request%20-%20Migration%20#{@migration.token}&body=Hello,%0D%0A%0D%0AI%20am%20trying%20to%20migrate%20to%20#{URI.encode_www_form_component(@migration.new_pds_host)}%20but%20encountered%20an%20orphaned%20account%20error.%0D%0A%0D%0AMigration%20Token:%20#{@migration.token}%0D%0ADID:%20#{@migration.did}%0D%0A%0D%0ACould%20you%20please%20remove%20the%20orphaned%20account%20so%20I%20can%20retry%20my%20migration?%0D%0A%0D%0AThank%20you!" %>
<%= email_label "Migration #{@migration.token}" %>
<%= email_title t('mailers.orphaned_account_error.heading') %>

<%= email_text 'Hello,' %>
<%= email_text t('mailers.orphaned_account_error.intro', token: @migration.token) %>

<%= email_warning do %>
  <%= email_heading 'What happened' %>
  <%= email_text t('mailers.orphaned_account_error.explanation') %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.orphaned_account_error.what_to_do') %>
  <%= email_list [
    t('mailers.orphaned_account_error.option1', email: @target_pds_support_email),
    t('mailers.orphaned_account_error.option2', did: @migration.did)
  ] %>
<% end %>

<%= email_heading 'Next steps: contact PDS provider' %>
<%= email_text do %>Please contact the support team for <strong><%= @migration.new_pds_host %></strong> to request removal of the orphaned account.<% end %>
<%= email_button "Email #{@target_pds_support_email}", support_mail_url %>
<%= email_text muted: true do %><strong>Include in your message:</strong><br>
  Migration Token: <%= email_code @migration.token %><br>
  DID: <%= email_code @migration.did %><% end %>

<%= email_well do %>
  <%= email_heading 'After support responds' %>
  <%= email_text "#{t('mailers.orphaned_account_error.option3', url: '').split(':').first}:" %>
  <%= email_list ordered: true do %>
    <%= email_list_item do %>Return to your <%= email_link 'migration status page', @migration_url %><% end %>
    <%= email_list_item 'Click the "Retry Migration" button' %>
    <%= email_list_item 'Your migration will resume automatically' %>
  <% end %>
<% end %>

<%= email_text muted: true do %><strong>Need help?</strong> Visit your <%= email_link 'migration status page', @migration_url %> for more details.<% end %>

<% email_footer do %>
  <%= email_text small: true do %>Migration Token: <%= email_code @migration.token %><% end %>
  <%= email_text small: true do %>DID: <%= email_code @migration.did %><% end %>
  <%= email_text "Target PDS: #{@migration.new_pds_host}", small: true %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
