<%
  support_mail_url = "mailto:#{@target_pds_support_email}?" + {
    subject: t('mailers.orphaned_account_error.mailto_subject', token: @migration.token),
    body: t('mailers.orphaned_account_error.mailto_body', pds: @migration.new_pds_host, token: @migration.token, did: @migration.did).gsub(/\r?\n/, "\r\n")
  }.map { |name, value| "#{name}=#{ERB::Util.url_encode(value)}" }.join('&')
  status_page_link = email_link(t('mailers.orphaned_account_error.status_page_link'), @migration_url)
%>
<%= email_label t('mailers.common.migration_label', token: @migration.token) %>
<%= email_title t('mailers.orphaned_account_error.heading') %>

<%= email_text t('mailers.common.hello') %>
<%= email_text t('mailers.orphaned_account_error.intro', token: @migration.token) %>

<%= email_warning do %>
  <%= email_heading t('mailers.common.what_happened') %>
  <%= email_text t('mailers.orphaned_account_error.explanation') %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.orphaned_account_error.what_to_do') %>
  <%= email_list [
    t('mailers.orphaned_account_error.option1', email: @target_pds_support_email),
    t('mailers.orphaned_account_error.option2', did: @migration.did)
  ] %>
<% end %>

<%= email_heading t('mailers.orphaned_account_error.contact_heading') %>
<%= email_text email_t('mailers.orphaned_account_error.contact_help', pds: tag.strong(@migration.new_pds_host)) %>
<%= email_button t('mailers.orphaned_account_error.email_support', email: @target_pds_support_email), support_mail_url %>
<%= email_text muted: true do %><strong><%= t('mailers.orphaned_account_error.include_heading') %></strong><br>
  <%= email_t('mailers.common.migration_token', token: email_code(@migration.token)) %><br>
  <%= email_label_value(t('mailers.common.label_did'), email_code(@migration.did)) %><% end %>

<%= email_well do %>
  <%= email_heading t('mailers.orphaned_account_error.after_heading') %>
  <%= email_text t('mailers.orphaned_account_error.option3') %>
  <%= email_list [
    email_t('mailers.orphaned_account_error.after1', link: status_page_link),
    t('mailers.orphaned_account_error.after2'),
    t('mailers.orphaned_account_error.after3')
  ], ordered: true %>
<% end %>

<%= email_text email_t('mailers.orphaned_account_error.need_help', link: status_page_link), muted: true %>

<% email_footer do %>
  <%= email_text email_t('mailers.common.migration_token', token: email_code(@migration.token)), small: true %>
  <%= email_text email_label_value(t('mailers.common.label_did'), email_code(@migration.did)), small: true %>
  <%= email_text email_label_value(t('mailers.common.label_target_pds'), @migration.new_pds_host), small: true %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
