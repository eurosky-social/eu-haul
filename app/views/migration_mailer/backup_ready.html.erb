<%= email_label "Migration #{@migration.token}" %>
<%= email_title t('mailers.backup_ready.heading') %>

<%= email_text 'Hello,' %>
<%= email_text t('mailers.backup_ready.intro', token: @migration.token) %>

<%= email_details do %>
  <%= email_detail_row 'DID', @migration.did %>
  <%= email_detail_row 'Old handle', "@#{@migration.old_handle}" %>
  <%= email_detail_row 'New handle', "@#{@migration.new_handle}" %>
  <% if @backup_size %>
    <%= email_detail_row t('mailers.backup_ready.size', size: '').split(':').first, number_to_human_size(@backup_size), mono: false %>
  <% end %>
<% end %>

<%= email_button t('mailers.backup_ready.download'), @download_url %>

<%= email_warning do %>
  <%= email_heading t('mailers.backup_ready.expires', time: (@expires_at.strftime('%B %d, %Y at %l:%M %p %Z') if @expires_at)) %>
  <%= email_text t('mailers.backup_ready.expiry_warning') %>
<% end %>

<%= email_well do %>
  <%= email_text t('mailers.backup_ready.whats_next') %>
<% end %>

<% email_footer do %>
  <%= email_text small: true do %>Migration Token: <%= email_code @migration.token %><% end %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
