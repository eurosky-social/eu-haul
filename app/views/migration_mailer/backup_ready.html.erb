<%= email_label t('mailers.common.migration_label', token: @migration.token) %>
<%= email_title t('mailers.backup_ready.heading') %>

<%= email_text t('mailers.common.hello') %>
<%= email_text t('mailers.backup_ready.intro', token: @migration.token) %>

<%= email_details do %>
  <%= email_detail_row t('mailers.common.label_did'), @migration.did %>
  <%= email_detail_row t('mailers.common.label_old_handle'), "@#{@migration.old_handle}" %>
  <%= email_detail_row t('mailers.common.label_new_handle'), "@#{@migration.new_handle}" %>
  <% if @backup_size %>
    <%= email_detail_row t('mailers.backup_ready.size_label'), number_to_human_size(@backup_size), mono: false %>
  <% end %>
<% end %>

<%= email_button t('mailers.backup_ready.download'), @download_url %>

<%= email_warning do %>
  <%= email_heading t('mailers.backup_ready.expires', time: email_time(@expires_at)) %>
  <%= email_text t('mailers.backup_ready.expiry_warning') %>
<% end %>

<%= email_well do %>
  <%= email_text t('mailers.backup_ready.whats_next') %>
<% end %>

<% email_footer do %>
  <%= email_text email_t('mailers.common.migration_token', token: email_code(@migration.token)), small: true %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
