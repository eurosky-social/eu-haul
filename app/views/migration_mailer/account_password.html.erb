<%= email_label t('mailers.common.migration_label', token: @migration.token) %>
<%= email_title t('mailers.account_password.heading') %>

<%= email_text t('mailers.common.hello') %>
<%= email_text t('mailers.account_password.intro') %>

<%= email_code_block @password, size: :medium, note: t('mailers.common.select_to_copy') %>

<%= email_warning do %>
  <%= email_heading t('mailers.account_password.security_notice') %>
  <%= email_text tag.strong(t('mailers.account_password.save_password')) %>
  <%= email_list [
    t('mailers.account_password.tip1'),
    t('mailers.account_password.tip2'),
    t('mailers.account_password.tip3')
  ] %>
<% end %>

<%= email_heading t('mailers.account_password.account_details') %>
<%= email_details do %>
  <%= email_detail_row t('mailers.common.label_new_handle'), "@#{@migration.new_handle}" %>
  <%= email_detail_row t('mailers.common.label_new_pds'), @migration.new_pds_host %>
  <%= email_detail_row t('mailers.common.label_email'), @migration.email %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.account_password.whats_happening') %>
  <%= email_list ordered: true do %>
    <% if @migration.create_backup_bundle %>
      <%= email_list_item t('mailers.account_password.backup_step1') %>
      <%= email_list_item t('mailers.account_password.backup_step2') %>
      <%= email_list_item t('mailers.account_password.backup_step3') %>
    <% else %>
      <%= email_list_item t('mailers.account_password.no_backup_step1') %>
      <%= email_list_item t('mailers.account_password.no_backup_step2') %>
    <% end %>
    <%= email_list_item t('mailers.account_password.no_backup_step3') %>
  <% end %>
  <%= email_text do %><%= t('mailers.account_password.track_progress') %> <%= email_link t('mailers.account_password.status_page_link'), @migration_url %><% end %>
<% end %>

<% email_footer do %>
  <%= email_text email_t('mailers.common.migration_token', token: email_code(@migration.token)), small: true %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
