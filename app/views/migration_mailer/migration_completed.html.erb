<% missing_blobs = @migration.progress_data['failed_blobs'] || [] %>
<%= email_title t('mailers.migration_completed.heading') %>

<%= email_text t('mailers.migration_completed.success') %>

<%# New account password %>
<% if @password.present? %>
  <%= email_heading t('mailers.migration_completed.password_heading') %>
  <%= email_text t('mailers.migration_completed.password_help') %>
  <%= email_code_block @password, size: :medium %>
  <% if missing_blobs.any? %>
    <%= email_warning do %>
      <%= email_text do %><strong><%= t('mailers.migration_completed.save_password') %></strong> <strong><%= t('mailers.migration_completed.change_password_wait') %></strong><% end %>
    <% end %>
  <% else %>
    <%= email_text muted: true do %><strong><%= t('mailers.migration_completed.save_password') %></strong> <%= t('mailers.migration_completed.change_password') %><% end %>
  <% end %>
<% end %>

<%# Backup download %>
<% if @backup_available %>
  <%= email_well do %>
    <%= email_heading t('mailers.migration_completed.backup_heading') %>
    <%= email_text t('mailers.migration_completed.backup_help', time: email_time(@migration.backup_expires_at)) %>
    <%= email_button t('mailers.migration_completed.download_backup'), @download_url %>
    <%= email_text t('mailers.migration_completed.backup_expiry'), muted: true %>
  <% end %>
<% end %>

<%# Migration details %>
<%= email_heading t('mailers.migration_completed.summary') %>
<%= email_details do %>
  <%= email_detail_row t('mailers.common.label_migration_token'), @migration.token %>
  <%= email_detail_row t('mailers.common.label_did'), @migration.did %>
  <%= email_detail_row t('mailers.migration_completed.old_account_label'), "#{@migration.old_handle} @ #{@migration.old_pds_host}" %>
  <%= email_detail_row t('mailers.migration_completed.new_account_label'), tag.strong("#{@migration.new_handle} @ #{@migration.new_pds_host}") %>
  <%= email_detail_row t('mailers.migration_completed.completed_at_label'), email_time(@completed_at), mono: false %>
<% end %>

<%# Status page %>
<%= email_text t('mailers.migration_completed.status_page'), muted: true %>
<%= email_button t('mailers.common.view_status'), @migration_url, secondary: true %>

<%# How to log in %>
<%= email_warning do %>
  <%= email_heading t('mailers.migration_completed.login_heading') %>
  <%= email_text t('mailers.migration_completed.login_help') %>
  <%= email_well do %>
    <%= email_text email_t('mailers.migration_completed.login_handle', handle: @migration.new_handle) %>
    <%= email_text tag.strong(email_t('mailers.migration_completed.hosting_warning', pds: @migration.new_pds_host)) %>
  <% end %>
  <%= email_text t('mailers.migration_completed.hosting_miss') %>
<% end %>

<% if missing_blobs.any? %>
  <%# Files still being transferred %>
  <%= email_warning do %>
    <%= email_heading t('mailers.migration_completed.missing_files_heading') %>
    <%= email_text t('mailers.migration_completed.missing_files_help', count: missing_blobs.length) %>
    <%= email_text email_link(@migration_url, @migration_url) %>
  <% end %>
<% end %>

<%# Change password %>
<%= email_warning do %>
  <%= email_heading t('mailers.migration_completed.change_password_heading') %>
  <% if missing_blobs.any? %>
    <%# Files are still arriving: changing the password now would cut off the transfer, so no button %>
    <%= email_text tag.strong(t('mailers.migration_completed.change_password_wait')) %>
  <% else %>
    <%= email_text t('mailers.migration_completed.change_password_help') %>
    <%= email_button t('mailers.migration_completed.change_password_button'), "#{@migration.new_pds_host}/.well-known/change-password", secondary: true %>
    <%= email_text t('mailers.migration_completed.change_password_later'), muted: true %>
  <% end %>
<% end %>

<%# What happens next %>
<%= email_well do %>
  <%= email_heading t('mailers.migration_completed.whats_next') %>
  <%= email_list [
    email_t('mailers.migration_completed.next1', pds: @migration.new_pds_host),
    t('mailers.migration_completed.next2', old_pds: @migration.old_pds_host),
    t('mailers.migration_completed.next3'),
    t('mailers.migration_completed.next4')
  ] %>
<% end %>

<%# Privacy and support %>
<% email_footer do %>
  <%= email_text tag.strong(t('mailers.migration_completed.privacy_heading')), small: true %>
  <%= email_list [
    t('mailers.migration_completed.privacy1'),
    t('mailers.migration_completed.privacy2')
  ], small: true %>
  <%= email_text small: true do %><%= t('mailers.migration_completed.support') %> <%= email_code @migration.token %><% end %>
  <%= email_text t('mailers.migration_completed.email_footer', email: @migration.email), small: true %>
<% end %>
