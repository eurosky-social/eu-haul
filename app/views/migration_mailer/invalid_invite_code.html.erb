<%= email_label "Migration #{@migration.token}" %>
<%= email_title 'Migration failed' %>
<%= email_text tag.strong(t('mailers.invalid_invite_code.heading')) %>

<%= email_text 'Hello,' %>
<%= email_text t('mailers.invalid_invite_code.intro', token: @migration.token) %>

<%= email_warning do %>
  <%= email_heading 'What happened' %>
  <%= email_text do %>The invite code provided for <strong><%= @migration.new_pds_host %></strong> was rejected. This can happen if:<% end %>
  <%= email_list [
    'The invite code was mistyped',
    'The invite code has already been used',
    'The invite code has expired',
    'The invite code is not valid for this PDS'
  ] %>
<% end %>

<%= email_well do %>
  <%= email_heading 'Your account is safe' %>
  <%= email_list do %>
    <%= email_list_item do %>No changes were made to your account on <strong><%= @migration.old_pds_host %></strong><% end %>
    <%= email_list_item 'No data was transferred or modified' %>
    <%= email_list_item 'Your account continues to work normally on your current PDS' %>
  <% end %>
<% end %>

<%= email_heading 'Start a new migration' %>
<%= email_text t('mailers.invalid_invite_code.what_to_do') %>
<%= email_button 'Start new migration', @new_migration_url %>

<% email_footer do %>
  <%= email_text small: true do %>Migration Token: <%= email_code @migration.token %><% end %>
  <%= email_text small: true do %>DID: <%= email_code @migration.did %><% end %>
  <%= email_text "Target PDS: #{@migration.new_pds_host}", small: true %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
