<%= email_title t('mailers.blobs_transfer_complete.heading') %>

<%= email_text t('mailers.blobs_transfer_complete.intro', pds: @migration.new_pds_host) %>

<%= email_well do %>
  <%= email_text tag.strong(t('mailers.blobs_transfer_complete.can_change_password', pds: @migration.new_pds_host)) %>
<% end %>

<%= email_text t('mailers.blobs_transfer_complete.status_page') %>
<%= email_text email_link(@migration_url, @migration_url) %>

<% email_footer do %>
  <%= email_text small: true do %><%= t('mailers.blobs_transfer_complete.support') %> <%= email_code @migration.token %><% end %>
<% end %>
