<%= email_title t('mailers.plc_token_failed.heading') %>
<%= email_text t('mailers.plc_token_failed.intro', token: @migration.token) %>

<%= email_well do %>
  <%= email_heading 'Your account is safe' %>
  <%= email_text do %>The PLC directory was <strong>not modified</strong>. Your account remains on
    <strong><%= @migration.old_pds_host %></strong> and all your migration data
    (repository, blobs, preferences) is safely stored and ready.<% end %>
<% end %>

<%= email_warning do %>
  <%= email_heading 'What happened?' %>
  <%= email_text 'The confirmation code from your old PDS provider expired before it could be used. These codes are only valid for a limited time (typically 1 hour).' %>
  <% if @error_message.present? %>
    <%= email_text tag.strong(t('mailers.plc_token_failed.error_detail', error: @error_message)) %>
  <% end %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.plc_token_failed.what_to_do') %>
  <%= email_list [
    t('mailers.plc_token_failed.step1'),
    t('mailers.plc_token_failed.step2'),
    t('mailers.plc_token_failed.step3')
  ], ordered: true %>
<% end %>

<%= email_button 'Go to migration status page', @migration_url %>

<%= email_heading 'Migration details:' %>
<%= email_details do %>
  <%= email_detail_row 'Token', @migration.token %>
  <%= email_detail_row 'DID', @migration.did %>
  <%= email_detail_row 'Old PDS', @migration.old_pds_host %>
  <%= email_detail_row 'New PDS', @migration.new_pds_host %>
<% end %>

<% email_footer do %>
  <%= email_text "This is an automated notification from #{EuroskyConfig::SITE_NAME}", small: true %>
  <%= email_text "Migration Token: #{@migration.token}", small: true %>
<% end %>
