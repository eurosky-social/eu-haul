<%= email_title t('mailers.plc_token_failed.heading') %>
<%= email_text t('mailers.plc_token_failed.intro', token: @migration.token) %>

<%= email_well do %>
  <%= email_heading t('mailers.common.account_safe') %>
  <%= email_text email_t('mailers.plc_token_failed.safe_text', pds: tag.strong(@migration.old_pds_host)) %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.common.what_happened') %>
  <%= email_text t('mailers.plc_token_failed.what_happened_text') %>
  <% if @error_message.present? %>
    <%= email_text tag.strong(t('mailers.plc_token_failed.error_detail', error: @error_message)) %>
  <% end %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.plc_token_failed.what_to_do') %>
  <%= email_list [
    t('mailers.plc_token_failed.step1'),
    t('mailers.plc_token_failed.step2'),
    t('mailers.plc_token_failed.step3')
  ], ordered: true %>
<% end %>

<%= email_button t('mailers.common.view_status'), @migration_url %>

<%= email_heading t('mailers.common.details_heading') %>
<%= email_details do %>
  <%= email_detail_row t('mailers.common.label_token'), @migration.token %>
  <%= email_detail_row t('mailers.common.label_did'), @migration.did %>
  <%= email_detail_row t('mailers.common.label_old_pds'), @migration.old_pds_host %>
  <%= email_detail_row t('mailers.common.label_new_pds'), @migration.new_pds_host %>
<% end %>

<% email_footer do %>
  <%= email_text t('mailers.common.automated_notification', site: EuroskyConfig::SITE_NAME), small: true %>
  <%= email_text email_t('mailers.common.migration_token', token: email_code(@migration.token)), small: true %>
<% end %>
