<%= email_title t('mailers.migration_failed.heading') %>

<%= email_text 'Hello,' %>
<%= email_text t('mailers.migration_failed.intro', token: h(@migration.token)).html_safe %>

<%= email_heading t('mailers.migration_failed.account_details') %>
<%= email_details do %>
  <%= email_detail_line t('mailers.migration_failed.did', did: h(@migration.did)).html_safe %>
  <%= email_detail_line t('mailers.migration_failed.old_handle', handle: @migration.old_handle) %>
  <%= email_detail_line t('mailers.migration_failed.new_handle', handle: @migration.new_handle) %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.migration_failed.failure_info') %>
  <%= email_details do %>
    <%= email_detail_line t('mailers.migration_failed.failed_step', step: @failed_step.to_s.humanize) %>
    <%= email_detail_line t('mailers.migration_failed.error', error: @error_message) %>
    <%= email_detail_line t('mailers.migration_failed.previous_retries', count: @retry_count) %>
  <% end %>
<% end %>

<% if @error_message&.match?(/PLC token.*expired/i) %>
  <%= email_heading 'PLC token expired' %>
  <%= email_text 'Your PLC operation token has expired. PLC tokens are only valid for 1 hour after they are issued.' %>

  <%= email_heading 'What you need to do:' %>
  <%= email_list ordered: true do %>
    <%= email_list_item 'Visit your migration status page using the button below' %>
    <%= email_list_item 'Click the "Request New PLC Token" button' %>
    <%= email_list_item do %>Check your email from <strong><%= @migration.old_pds_host %></strong> for the new token<% end %>
    <%= email_list_item 'Submit the new token within 1 hour' %>
  <% end %>

  <%= email_button 'View migration & request new token', @migration_url %>

  <%= email_well do %>
    <%= email_text tag.strong('Good news:') %>
    <%= email_text 'Your migration data is safe and ready. You just need a fresh PLC token to complete the final step.' %>
  <% end %>
<% else %>
  <%= email_heading t('mailers.migration_failed.what_to_do') %>
  <%= email_list [t('mailers.migration_failed.do_step1')], ordered: true %>

  <%= email_button 'View migration & retry', @migration_url %>

  <%= email_text tag.strong(t('mailers.migration_failed.common_issues')) %>
  <%= email_list [
    t('mailers.migration_failed.issue1'),
    t('mailers.migration_failed.issue2'),
    t('mailers.migration_failed.issue3')
  ] %>
<% end %>

<%= email_warning do %>
  <%= email_text tag.strong(t('mailers.migration_failed.important')) %>
  <%= email_list [
    t('mailers.migration_failed.note1'),
    t('mailers.migration_failed.note2'),
    t('mailers.migration_failed.note3', token: h(@migration.token)).html_safe
  ] %>
<% end %>

<% email_footer do %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
