<%= email_title t('mailers.migration_failed.heading') %>

<%= email_text t('mailers.common.hello') %>
<%= email_text email_t('mailers.migration_failed.intro', token: @migration.token) %>

<%= email_heading t('mailers.migration_failed.account_details') %>
<%= email_details do %>
  <%= email_detail_line email_t('mailers.migration_failed.did', did: @migration.did) %>
  <%= email_detail_line t('mailers.migration_failed.old_handle', handle: @migration.old_handle) %>
  <%= email_detail_line t('mailers.migration_failed.new_handle', handle: @migration.new_handle) %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.migration_failed.failure_info') %>
  <%= email_details do %>
    <% if (step_name = email_step_name(@failed_step)) %>
      <%= email_detail_line t('mailers.migration_failed.failed_step', step: step_name) %>
    <% end %>
    <%= email_detail_line t('mailers.migration_failed.error', error: @error_message) %>
    <%= email_detail_line t('mailers.migration_failed.previous_retries', count: @retry_count) %>
  <% end %>
<% end %>

<% if @error_message&.match?(/PLC token.*expired/i) %>
  <%= email_heading t('mailers.migration_failed.plc_expired_heading') %>
  <%= email_text t('mailers.migration_failed.plc_expired_text') %>

  <%= email_heading t('mailers.migration_failed.plc_expired_steps') %>
  <%= email_list [
    t('mailers.migration_failed.plc_expired_step1'),
    t('mailers.migration_failed.plc_expired_step2'),
    email_t('mailers.migration_failed.plc_expired_step3', pds: tag.strong(@migration.old_pds_host)),
    t('mailers.migration_failed.plc_expired_step4')
  ], ordered: true %>

  <%= email_button t('mailers.migration_failed.plc_expired_button'), @migration_url %>

  <%= email_well do %>
    <%= email_text tag.strong(t('mailers.migration_failed.plc_expired_good_news')) %>
    <%= email_text t('mailers.migration_failed.plc_expired_safe') %>
  <% end %>
<% else %>
  <%= email_heading t('mailers.migration_failed.what_to_do') %>
  <%= email_list [t('mailers.migration_failed.do_step1')], ordered: true %>

  <%= email_button t('mailers.migration_failed.retry_button'), @migration_url %>

  <%= email_text tag.strong(t('mailers.migration_failed.common_issues')) %>
  <%= email_list [
    t('mailers.migration_failed.issue1'),
    t('mailers.migration_failed.issue2'),
    t('mailers.migration_failed.issue3')
  ] %>
<% end %>

<%= email_warning do %>
  <%= email_text tag.strong(t('mailers.migration_failed.important')) %>
  <%= email_list [
    t('mailers.migration_failed.note1'),
    t('mailers.migration_failed.note2'),
    email_t('mailers.migration_failed.note3', token: @migration.token)
  ] %>
<% end %>

<% email_footer do %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
