<%= email_label "Migration #{@migration.token}" %>
<%= email_title t('mailers.plc_otp.heading') %>
<%= email_text tag.strong(t('mailers.plc_otp.critical')) %>

<%= email_text 'Hello,' %>
<%= email_text t('mailers.plc_otp.intro').html_safe %>

<%= email_code_block @otp, size: :large, caption: t('mailers.plc_otp.your_code'),
                     note: safe_join(['Click to select and copy', tag.br, tag.strong(t('mailers.plc_otp.expires_in', time: @expires_in))]) %>

<%= email_warning do %>
  <%= email_heading t('mailers.plc_otp.point_of_no_return') %>
  <%= email_text tag.strong(t('mailers.plc_otp.point_of_no_return_detail')) %>
  <%= email_list [
    t('mailers.plc_otp.did_will_point'),
    t('mailers.plc_otp.cannot_undo'),
    t('mailers.plc_otp.ensure_ready')
  ] %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.plc_otp.how_to_use') %>
  <%= email_list [
    safe_join([t('mailers.plc_otp.step1'), email_link('migration status page', @migration_url)], ' '),
    t('mailers.plc_otp.step2'),
    t('mailers.plc_otp.step3', code: @otp),
    t('mailers.plc_otp.step4')
  ], ordered: true %>
  <%= email_text do %><strong>Note:</strong> <%= t('mailers.plc_otp.attempts_note') %><% end %>
<% end %>

<% email_footer do %>
  <%= email_text small: true do %>Migration Token: <%= email_code @migration.token %><% end %>
  <%= email_text t('mailers.plc_otp.not_you'), small: true %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
