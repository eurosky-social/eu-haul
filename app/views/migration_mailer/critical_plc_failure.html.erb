<%= email_title t('mailers.critical_plc_failure.heading') %>
<%= email_text t('mailers.critical_plc_failure.summary') %>

<%= email_warning do %>
  <%= email_text do %><%= t('mailers.critical_plc_failure.intro', token: @migration.token) %>
    <strong><%= t('mailers.critical_plc_failure.uncertain_state') %></strong><% end %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.critical_plc_failure.warning') %>
  <%= email_text tag.strong(t('mailers.critical_plc_failure.do_not_heading')) %>
  <%= email_list [
    tag.strong(t('mailers.critical_plc_failure.do_not1')),
    tag.strong(t('mailers.critical_plc_failure.do_not2')),
    tag.strong(t('mailers.critical_plc_failure.do_not3')),
    tag.strong(t('mailers.critical_plc_failure.do_not4'))
  ] %>
  <%= email_text t('mailers.critical_plc_failure.data_safe') %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.critical_plc_failure.right_now_heading') %>
  <%= email_list ordered: true do %>
    <%= email_list_item tag.strong(t('mailers.critical_plc_failure.step_save_email')) %>
    <%= email_list_item do %>
      <%= email_text tag.strong(t('mailers.critical_plc_failure.step_save_token')) %>
      <%= email_code_block @migration.token %>
    <% end %>
    <% if @rotation_key.present? %>
      <%= email_list_item do %>
        <%= email_text tag.strong(t('mailers.critical_plc_failure.key_heading')) %>
        <%= email_code_block @rotation_key %>
        <%= email_text t('mailers.critical_plc_failure.key_help'), muted: true %>
      <% end %>
    <% end %>
    <%= email_list_item do %>
      <%= email_text tag.strong(t('mailers.critical_plc_failure.contact')) %>
      <%= email_code_block @support_email %>
    <% end %>
    <%= email_list_item do %>
      <%= email_text tag.strong(t('mailers.critical_plc_failure.step_reference_token')) %>
      <%= email_code_block @migration.token %>
    <% end %>
  <% end %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.common.what_happened') %>
  <%= email_text t('mailers.critical_plc_failure.what_happened_text') %>
  <%= email_text tag.strong(t('mailers.critical_plc_failure.error_detail', error: '')) %>
  <%= email_code_block @error_message, break_all: false %>
<% end %>

<%= email_well do %>
  <%= email_heading t('mailers.common.what_happens_next') %>
  <%= email_text t('mailers.critical_plc_failure.support_will') %>
  <%= email_list [
    t('mailers.critical_plc_failure.support1'),
    t('mailers.critical_plc_failure.support2'),
    t('mailers.critical_plc_failure.support3'),
    t('mailers.critical_plc_failure.support4')
  ] %>
  <%= email_text tag.strong(t('mailers.critical_plc_failure.wait_for_support')) %>
<% end %>

<%= email_button t('mailers.common.view_status'), @migration_url %>

<%= email_heading t('mailers.common.details_heading') %>
<%= email_details do %>
  <%= email_detail_row t('mailers.common.label_token'), @migration.token %>
  <%= email_detail_row t('mailers.common.label_did'), @migration.did %>
  <%= email_detail_row t('mailers.common.label_old_pds'), @migration.old_pds_host %>
  <%= email_detail_row t('mailers.common.label_new_pds'), @migration.new_pds_host %>
<% end %>

<% email_footer do %>
  <%= email_text t('mailers.critical_plc_failure.automated', site: EuroskyConfig::SITE_NAME), small: true %>
  <%= email_text email_label_value(t('mailers.common.label_support_email'), @support_email), small: true %>
  <%= email_text email_t('mailers.common.migration_token', token: email_code(@migration.token)), small: true %>
<% end %>
