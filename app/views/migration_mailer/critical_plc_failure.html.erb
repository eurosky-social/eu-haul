<%= email_title t('mailers.critical_plc_failure.heading') %>
<%= email_text 'Your AT Protocol account migration has encountered a critical error' %>

<%= email_warning do %>
  <%= email_heading t('mailers.critical_plc_failure.heading') %>
  <%= email_text do %><%= t('mailers.critical_plc_failure.intro', token: @migration.token) %>
    <strong>Your account may be in an uncertain state.</strong><% end %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.critical_plc_failure.warning') %>
  <%= email_list [
    tag.strong('Start a new migration'),
    tag.strong('Delete this email'),
    tag.strong('Attempt manual recovery without support'),
    tag.strong('Change your account settings on either PDS')
  ] %>
  <%= email_text 'Your account data is safe, but the PLC directory state needs to be verified by our support team before you take any action.' %>
<% end %>

<%= email_warning do %>
  <%= email_heading 'What to do right now:' %>
  <%= email_list ordered: true do %>
    <%= email_list_item do %><strong>Save this email</strong> - You will need the information below<% end %>
    <%= email_list_item do %>
      <%= email_text tag.strong('Save your migration token:') %>
      <%= email_code_block @migration.token %>
    <% end %>
    <% if @rotation_key.present? %>
      <%= email_list_item do %>
        <%= email_text tag.strong(t('mailers.critical_plc_failure.key_heading')) %>
        <%= email_code_block @rotation_key %>
        <%= email_text t('mailers.critical_plc_failure.key_help'), muted: true %>
      <% end %>
    <% end %>
    <%= email_list_item do %>
      <%= email_text tag.strong(t('mailers.critical_plc_failure.contact')) %>
      <%= email_code_block @support_email %>
    <% end %>
    <%= email_list_item do %>
      <%= email_text do %><strong>Reference your migration token</strong> in your support request:<% end %>
      <%= email_code_block @migration.token %>
    <% end %>
  <% end %>
<% end %>

<%= email_well do %>
  <%= email_heading 'What happened?' %>
  <%= email_text 'The migration failed during the PLC directory update, which is the critical step that redirects your DID to the new PDS.' %>
  <%= email_text tag.strong(t('mailers.critical_plc_failure.error_detail', error: '')) %>
  <%= email_code_block @error_message, break_all: false %>
<% end %>

<%= email_well do %>
  <%= email_heading 'What happens next?' %>
  <%= email_text 'Our support team will:' %>
  <%= email_list [
    'Investigate the PLC directory state for your DID',
    'Determine whether the PLC operation succeeded or failed',
    'Provide you with specific recovery instructions',
    'Contact you within 24 hours via email'
  ] %>
  <%= email_text do %><strong>Do not take any action</strong> until you hear from support. We will guide you through the recovery process.<% end %>
<% end %>

<%= email_button 'View migration status', @migration_url %>

<%= email_heading 'Migration details:' %>
<%= email_details do %>
  <%= email_detail_row 'Token', @migration.token %>
  <%= email_detail_row 'DID', @migration.did %>
  <%= email_detail_row 'Old PDS', @migration.old_pds_host %>
  <%= email_detail_row 'New PDS', @migration.new_pds_host %>
<% end %>

<% email_footer do %>
  <%= email_text "This is an automated critical alert from #{EuroskyConfig::SITE_NAME}", small: true %>
  <%= email_text "Support Email: #{@support_email}", small: true %>
  <%= email_text "Migration Token: #{@migration.token}", small: true %>
<% end %>
