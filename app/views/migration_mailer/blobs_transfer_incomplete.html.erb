<%= email_title t('mailers.blobs_transfer_incomplete.heading') %>

<%= email_text t('mailers.blobs_transfer_incomplete.intro', count: @failed_count, pds: @migration.new_pds_host) %>

<%= email_text t('mailers.blobs_transfer_incomplete.what_to_do') %>
<%= email_text email_link(@migration_url, @migration_url) %>

<%= email_warning do %>
  <%= email_text tag.strong(t('mailers.blobs_transfer_incomplete.keep_password', pds: @migration.new_pds_host)) %>
<% end %>

<% email_footer do %>
  <%= email_text small: true do %><%= t('mailers.blobs_transfer_incomplete.support') %> <%= email_code @migration.token %><% end %>
<% end %>
