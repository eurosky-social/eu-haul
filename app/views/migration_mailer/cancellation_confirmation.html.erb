<%= email_label "Migration #{@migration.token}" %>
<%= email_title t('mailers.cancellation_confirmation.heading') %>

<%= email_text 'Hello,' %>
<%= email_text t('mailers.cancellation_confirmation.intro', token: @migration.token) %>

<%= email_well do %>
  <%= email_heading 'Your account is safe' %>
  <%= email_text do %>No changes have been made to your account. Cancelling this migration will simply stop the process.
    Your account will remain on <strong><%= @migration.old_pds_host %></strong> and continue to work normally.<% end %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.cancellation_confirmation.confirm_help') %>
  <%= email_text 'This action cannot be undone. You will need to start a new migration if you change your mind.' %>
  <%= email_button t('mailers.cancellation_confirmation.confirm_link'), @confirm_url %>
<% end %>

<%= email_warning do %>
  <%= email_heading "Didn't request this?" %>
  <%= email_text t('mailers.cancellation_confirmation.not_you') %>
<% end %>

<% email_footer do %>
  <%= email_text small: true do %>Migration Token: <%= email_code @migration.token %><% end %>
  <%= email_text small: true do %>DID: <%= email_code @migration.did %><% end %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
