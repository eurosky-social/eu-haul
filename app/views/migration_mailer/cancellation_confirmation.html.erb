<%= email_label t('mailers.common.migration_label', token: @migration.token) %>
<%= email_title t('mailers.cancellation_confirmation.heading') %>

<%= email_text t('mailers.common.hello') %>
<%= email_text t('mailers.cancellation_confirmation.intro', token: @migration.token) %>

<%= email_well do %>
  <%= email_heading t('mailers.common.account_safe') %>
  <%= email_text email_t('mailers.cancellation_confirmation.safe_text', pds: tag.strong(@migration.old_pds_host)) %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.cancellation_confirmation.confirm_help') %>
  <%= email_text t('mailers.cancellation_confirmation.cannot_undo') %>
  <%= email_button t('mailers.cancellation_confirmation.confirm_link'), @confirm_url %>
<% end %>

<%= email_warning do %>
  <%= email_heading t('mailers.cancellation_confirmation.not_you_heading') %>
  <%= email_text t('mailers.cancellation_confirmation.not_you') %>
<% end %>

<% email_footer do %>
  <%= email_text email_t('mailers.common.migration_token', token: email_code(@migration.token)), small: true %>
  <%= email_text email_label_value(t('mailers.common.label_did'), email_code(@migration.did)), small: true %>
  <%= email_text t('mailers.common.eurosky_migration'), small: true %>
<% end %>
